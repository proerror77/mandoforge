{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "case_id",
    "case_state",
    "recommended_action",
    "evidence_checklist",
    "evidence_gaps",
    "buyer_facing_draft",
    "operator_review_reason",
    "risk_tier",
    "approval_required",
    "external_write_blocked_until_approved",
    "provenance"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "case_state": {
      "type": "string",
      "enum": [
        "refund_only",
        "return_and_refund",
        "exchange",
        "logistics_dispute",
        "damaged_item",
        "missing_item",
        "counterfeit_claim",
        "platform_intervention"
      ]
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "agree_refund",
        "refuse_refund",
        "agree_return_goods",
        "refuse_return_goods",
        "request_buyer_evidence",
        "create_internal_task"
      ]
    },
    "evidence_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence", "status"],
        "properties": {
          "evidence": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["present", "missing", "conflicting"] },
          "source": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "policy_basis": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "buyer_facing_draft": { "type": "string", "minLength": 1 },
    "internal_notes": { "type": "array", "items": { "type": "string" } },
    "operator_review_reason": { "type": "string", "minLength": 1 },
    "risk_tier": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "approval_required": { "type": "boolean", "const": true },
    "external_write_blocked_until_approved": { "type": "boolean", "const": true },
    "approval_bind_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["tenant_id", "workspace_id", "connector_id", "api_name", "operation_id", "object_id", "payload_digest"]
      }
    },
    "critical_gate": {
      "type": "string",
      "enum": ["platform_intervention", "refund_refuse", "compensation_commitment", "counterfeit_or_legal_claim", "policy_exception"]
    },
    "provenance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
