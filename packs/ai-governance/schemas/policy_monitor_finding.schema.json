{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "policy_id",
    "monitored_source",
    "signal_type",
    "finding",
    "severity",
    "recommended_action",
    "approval_required",
    "draft_only",
    "provenance"
  ],
  "properties": {
    "policy_id": { "type": "string", "minLength": 1 },
    "monitored_source": { "type": "string", "minLength": 1 },
    "signal_type": {
      "type": "string",
      "enum": ["new_use_case", "vendor_change", "control_gap", "policy_exception"]
    },
    "finding": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"]
    },
    "recommended_action": { "type": "string", "minLength": 1 },
    "approval_required": { "type": "boolean" },
    "draft_only": { "const": true },
    "provenance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
