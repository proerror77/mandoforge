ARG RUST_IMAGE=public.ecr.aws/docker/library/rust:1.97.0-bookworm@sha256:7d0723df719e7f213b69dc7c8c595985c3f4b060cfbee4f7bc0e347a86fe3b6a
ARG NODE_IMAGE=public.ecr.aws/docker/library/node:24.18.0-bookworm-slim@sha256:cb4e8f7c443347358b7875e717c29e27bf9befc8f5a26cf18af3c3dec80e58c5
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa
ARG MANDOFORGE_SOURCE_TREE

FROM ${RUST_IMAGE} AS sccache-builder
RUN cargo install --locked sccache --version 0.16.0

FROM ${RUST_IMAGE} AS launcher-builder
ARG MANDOFORGE_SOURCE_TREE
WORKDIR /src
COPY .mandoforge-tracked-context /tmp/mandoforge-source-tree
COPY . .
RUN test -n "${MANDOFORGE_SOURCE_TREE}" \
    && test "$(cat /tmp/mandoforge-source-tree)" = "${MANDOFORGE_SOURCE_TREE}" \
    && rm /tmp/mandoforge-source-tree /src/.mandoforge-tracked-context \
    && cargo build --locked --release -p mandoforge-api --bin mandoforge-sandbox-runtime

FROM ${NODE_IMAGE} AS node-runtime
FROM ${UV_IMAGE} AS uv-runtime

FROM ${RUST_IMAGE} AS runtime
ARG MANDOFORGE_SOURCE_TREE
ARG PNPM_VERSION=11.11.0
ARG CODEX_VERSION=0.144.1
ARG CLAUDE_CODE_VERSION=2.1.206

ENV MANDOFORGE_RUNTIME_RUST_VERSION=1.97.0 \
    MANDOFORGE_RUNTIME_NODE_VERSION=24.18.0 \
    MANDOFORGE_RUNTIME_PNPM_VERSION=${PNPM_VERSION} \
    MANDOFORGE_RUNTIME_UV_VERSION=0.11.28 \
    MANDOFORGE_RUNTIME_SCCACHE_VERSION=0.16.0 \
    MANDOFORGE_RUNTIME_CODEX_VERSION=${CODEX_VERSION} \
    MANDOFORGE_RUNTIME_CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION} \
    CARGO_HOME=/cache/project/cargo \
    SCCACHE_DIR=/cache/project/sccache \
    PNPM_STORE_DIR=/cache/project/pnpm \
    UV_CACHE_DIR=/cache/project/uv

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install --global \
        "pnpm@${PNPM_VERSION}" \
        "@openai/codex@${CODEX_VERSION}" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force

COPY --from=uv-runtime /uv /uvx /usr/local/bin/
COPY --from=sccache-builder /usr/local/cargo/bin/sccache /usr/local/bin/sccache
COPY --from=launcher-builder /src/target/release/mandoforge-sandbox-runtime /usr/local/bin/mandoforge-sandbox-runtime
RUN for executable in cargo cargo-clippy cargo-fmt clippy-driver rustc rustdoc rustfmt rustup; do \
        ln -s "/usr/local/cargo/bin/${executable}" "/usr/local/bin/${executable}"; \
    done \
    && env PATH=/usr/local/bin:/usr/bin:/bin rustc --version \
    && env PATH=/usr/local/bin:/usr/bin:/bin cargo --version \
    && env PATH=/usr/local/bin:/usr/bin:/bin sccache --version \
    && env PATH=/usr/local/bin:/usr/bin:/bin node --version \
    && env PATH=/usr/local/bin:/usr/bin:/bin pnpm --version \
    && env PATH=/usr/local/bin:/usr/bin:/bin uv --version \
    && env PATH=/usr/local/bin:/usr/bin:/bin codex --version \
    && env PATH=/usr/local/bin:/usr/bin:/bin claude --version

COPY . /opt/mandoforge-source
RUN test -n "${MANDOFORGE_SOURCE_TREE}" \
    && test "$(cat /opt/mandoforge-source/.mandoforge-tracked-context)" = "${MANDOFORGE_SOURCE_TREE}" \
    && rm -rf \
        /opt/mandoforge-source/.mandoforge-tracked-context \
        /opt/mandoforge-source/.git \
        /opt/mandoforge-source/.mandoforge \
        /opt/mandoforge-source/.superpowers \
        /opt/mandoforge-source/target \
        /opt/mandoforge-source/node_modules \
        /opt/mandoforge-source/web-ui/node_modules \
    && git -C /opt/mandoforge-source init --initial-branch=main \
    && git -C /opt/mandoforge-source config user.name "MandoForge Runtime Snapshot" \
    && git -C /opt/mandoforge-source config user.email "runtime-snapshot@invalid" \
    && git -C /opt/mandoforge-source add --all \
    && git -C /opt/mandoforge-source commit -m "MandoForge runtime source snapshot" \
    && test -z "$(git -C /opt/mandoforge-source status --porcelain)" \
    && git config --system --add safe.directory /opt/mandoforge-source \
    && useradd --uid 1000 --create-home --shell /bin/bash mandoforge \
    && mkdir -p /workspace/sessions /cache/project/cargo /cache/project/sccache /cache/project/pnpm /cache/project/uv \
    && chown -R mandoforge:mandoforge /workspace /cache/project

LABEL org.opencontainers.image.title="mandoforge-agent-sandbox-runtime" \
      org.opencontainers.image.description="Pinned MandoForge Agent Sandbox CLI runtime"

USER mandoforge
WORKDIR /workspace/sessions
CMD ["sleep", "infinity"]
