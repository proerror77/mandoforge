# MandoForge Stage 2 production evidence controller template.
# Copy selected values into your deployment secret manager or CI environment.
# Do not commit real tokens or production URLs.
#
# The evidence gate still fails closed until /api/stage2/readiness has no open
# gaps. These values only wire the API to real validation targets.

# Evidence gate execution.
RUN_STAGE2_PRODUCTION_VALIDATIONS=1
VERIFY_STAGE2_VALIDATION_COVERAGE=1
ALLOW_BLOCKED=0
# Optional: leave empty to auto-discover the first active team through
# /api/organizations and /api/organizations/{id}/teams during evidence runs.
MANDOFORGE_STAGE2_TEAM_ID=

# Tenant routing / RLS validation.
MANDOFORGE_TENANT_ROUTING_CONTROLLER_REQUIRED=true
MANDOFORGE_TENANT_ROUTING_CONTROLLER_URL=https://controller.example.com/mandoforge/tenant-routing/validate
MANDOFORGE_TENANT_ROUTING_CONTROLLER_TOKEN=

# Provider governance validation, rollout, and rollback.
MANDOFORGE_PROVIDER_DEPLOYMENT_CONTROLLER_REQUIRED=true
MANDOFORGE_PROVIDER_DEPLOYMENT_CONTROLLER_URL=https://controller.example.com/mandoforge/providers/deployment/validate
MANDOFORGE_PROVIDER_DEPLOYMENT_CONTROLLER_TOKEN=
MANDOFORGE_PROVIDER_ROLLOUT_CONTROLLER_URL=https://controller.example.com/mandoforge/providers/rollout/apply
MANDOFORGE_PROVIDER_ROLLOUT_TOKEN=
MANDOFORGE_PROVIDER_ROLLOUT_ROLLBACK_CONTROLLER_URL=https://controller.example.com/mandoforge/providers/rollout/rollback
MANDOFORGE_PROVIDER_ROLLOUT_ROLLBACK_TOKEN=
RUN_STAGE2_PROVIDER_ROLLOUT=1

# Policy rollout orchestration.
MANDOFORGE_POLICY_ROLLOUT_ORCHESTRATION_CONTROLLER_REQUIRED=true
MANDOFORGE_POLICY_ROLLOUT_ORCHESTRATION_CONTROLLER_URL=https://controller.example.com/mandoforge/policy/rollout/validate
MANDOFORGE_POLICY_ROLLOUT_ORCHESTRATION_CONTROLLER_TOKEN=

# Vault and external KMS/HSM lifecycle.
MANDOFORGE_KMS_PROVIDER=external
MANDOFORGE_KMS_KEY_ID=
MANDOFORGE_KMS_ROTATION_POLICY=
MANDOFORGE_KMS_VALIDATION_MODE=external
MANDOFORGE_KMS_TIMEOUT_SECONDS=10
MANDOFORGE_KMS_ENDPOINT=https://controller.example.com/mandoforge/kms/rotate
MANDOFORGE_KMS_TOKEN=
MANDOFORGE_KMS_RECOVERY_CONTROLLER_REQUIRED=true
MANDOFORGE_KMS_RECOVERY_CONTROLLER_URL=https://controller.example.com/mandoforge/kms/recovery/validate
MANDOFORGE_KMS_RECOVERY_CONTROLLER_TOKEN=
RUN_STAGE2_SECRET_LIFECYCLE=1

# Worker queue, autoscaling, and Remote Computer cluster validation.
MANDOFORGE_WORKER_LOAD_VALIDATION_CONTROLLER_REQUIRED=true
MANDOFORGE_WORKER_LOAD_VALIDATION_CONTROLLER_URL=https://controller.example.com/mandoforge/workers/load/validate
MANDOFORGE_WORKER_LOAD_VALIDATION_CONTROLLER_TOKEN=
MANDOFORGE_REMOTE_COMPUTER_STATE_SYNC_CONTROLLER_REQUIRED=true
MANDOFORGE_REMOTE_COMPUTER_STATE_SYNC_CONTROLLER_URL=https://controller.example.com/mandoforge/remote-computers/state-sync/validate
MANDOFORGE_REMOTE_COMPUTER_STATE_SYNC_CONTROLLER_TOKEN=
MANDOFORGE_REMOTE_COMPUTER_SIDECAR_REPLACEMENT_ENABLED=false
MANDOFORGE_REMOTE_COMPUTER_SIDECAR_VALIDATION_REQUIRED=true
MANDOFORGE_REMOTE_COMPUTER_SIDECAR_VALIDATION_URL=https://controller.example.com/mandoforge/remote-computers/sidecars/validate
MANDOFORGE_REMOTE_COMPUTER_SIDECAR_VALIDATION_TOKEN=
RUN_STAGE2_REMOTE_SIDECAR_RECOVERY=1

# Approval notification deployment and ops validation.
MANDOFORGE_APPROVAL_NOTIFICATION_DEPLOYMENT_CONTROLLER_REQUIRED=true
MANDOFORGE_APPROVAL_NOTIFICATION_DEPLOYMENT_CONTROLLER_URL=https://controller.example.com/mandoforge/approvals/notifications/deployment/validate
MANDOFORGE_APPROVAL_NOTIFICATION_DEPLOYMENT_CONTROLLER_TOKEN=
MANDOFORGE_APPROVAL_NOTIFICATION_OPS_CONTROLLER_REQUIRED=true
MANDOFORGE_APPROVAL_NOTIFICATION_OPS_CONTROLLER_URL=https://controller.example.com/mandoforge/approvals/notifications/ops/validate
MANDOFORGE_APPROVAL_NOTIFICATION_OPS_CONTROLLER_TOKEN=
RUN_STAGE2_APPROVAL_DELIVERY=1

# MCP connector deployment and rollout validation.
MANDOFORGE_MCP_DEPLOYMENT_CONTROLLER_REQUIRED=true
MANDOFORGE_MCP_DEPLOYMENT_CONTROLLER_URL=https://controller.example.com/mandoforge/mcp/deployment/validate
MANDOFORGE_MCP_DEPLOYMENT_CONTROLLER_TOKEN=
MANDOFORGE_MCP_ROLLOUT_CONTROLLER_REQUIRED=true
MANDOFORGE_MCP_ROLLOUT_CONTROLLER_URL=https://controller.example.com/mandoforge/mcp/rollout/apply
MANDOFORGE_MCP_ROLLOUT_CONTROLLER_TOKEN=
MANDOFORGE_MCP_ROLLOUT_ROLLBACK_CONTROLLER_REQUIRED=true
MANDOFORGE_MCP_ROLLOUT_ROLLBACK_CONTROLLER_URL=https://controller.example.com/mandoforge/mcp/rollout/rollback
MANDOFORGE_MCP_ROLLOUT_ROLLBACK_CONTROLLER_TOKEN=

# Codex App Server deployment and ops validation.
MANDOFORGE_CODEX_APP_SERVER_URL=https://codex-app-server.example.com
MANDOFORGE_CODEX_APP_SERVER_DEPLOYMENT_CONTROLLER_REQUIRED=true
MANDOFORGE_CODEX_APP_SERVER_DEPLOYMENT_CONTROLLER_URL=https://controller.example.com/mandoforge/codex-app-server/deployment/validate
MANDOFORGE_CODEX_APP_SERVER_DEPLOYMENT_CONTROLLER_TOKEN=
MANDOFORGE_CODEX_APP_SERVER_OPS_CONTROLLER_REQUIRED=true
MANDOFORGE_CODEX_APP_SERVER_OPS_CONTROLLER_URL=https://controller.example.com/mandoforge/codex-app-server/ops/validate
MANDOFORGE_CODEX_APP_SERVER_OPS_CONTROLLER_TOKEN=
RUN_STAGE2_CODEX_STALE_POLL=1

# Eval/release rollout validation.
MANDOFORGE_AGENT_RELEASE_CONTROLLER_REQUIRED=true
MANDOFORGE_AGENT_RELEASE_CONTROLLER_URL=https://controller.example.com/mandoforge/agents/releases/rollout/apply
MANDOFORGE_AGENT_RELEASE_CONTROLLER_TOKEN=
MANDOFORGE_AGENT_RELEASE_DEPLOYMENT_CONTROLLER_REQUIRED=true
MANDOFORGE_AGENT_RELEASE_DEPLOYMENT_CONTROLLER_URL=https://controller.example.com/mandoforge/agents/releases/deployment/validate
MANDOFORGE_AGENT_RELEASE_DEPLOYMENT_CONTROLLER_TOKEN=
MANDOFORGE_AGENT_RELEASE_ORCHESTRATION_CONTROLLER_REQUIRED=true
MANDOFORGE_AGENT_RELEASE_ORCHESTRATION_CONTROLLER_URL=https://controller.example.com/mandoforge/agents/releases/orchestration/validate
MANDOFORGE_AGENT_RELEASE_ORCHESTRATION_CONTROLLER_TOKEN=
MANDOFORGE_AGENT_RELEASE_ROLLBACK_CONTROLLER_REQUIRED=true
MANDOFORGE_AGENT_RELEASE_ROLLBACK_CONTROLLER_URL=https://controller.example.com/mandoforge/agents/releases/rollout/rollback
MANDOFORGE_AGENT_RELEASE_ROLLBACK_CONTROLLER_TOKEN=
RUN_STAGE2_EVAL_RELEASE_AUTOMATION=1

# Observability collector and remediation validation.
MANDOFORGE_OBSERVABILITY_COLLECTOR_DEPLOYMENT_CONTROLLER_REQUIRED=true
MANDOFORGE_OBSERVABILITY_COLLECTOR_DEPLOYMENT_CONTROLLER_URL=https://controller.example.com/mandoforge/observability/collector/deployment/validate
MANDOFORGE_OBSERVABILITY_COLLECTOR_DEPLOYMENT_CONTROLLER_TOKEN=
MANDOFORGE_OBSERVABILITY_COLLECTOR_CLUSTER_CONTROLLER_REQUIRED=true
MANDOFORGE_OBSERVABILITY_COLLECTOR_CLUSTER_CONTROLLER_URL=https://controller.example.com/mandoforge/observability/collector/cluster/validate
MANDOFORGE_OBSERVABILITY_COLLECTOR_CLUSTER_CONTROLLER_TOKEN=
MANDOFORGE_OBSERVABILITY_REMEDIATION_CONTROLLER_REQUIRED=true
MANDOFORGE_OBSERVABILITY_REMEDIATION_CONTROLLER_URL=https://controller.example.com/mandoforge/observability/remediation/run
MANDOFORGE_OBSERVABILITY_REMEDIATION_CONTROLLER_TOKEN=
RUN_STAGE2_OBSERVABILITY_REMEDIATION=1

# Finance close and accounting reconciliation.
MANDOFORGE_FINANCE_CLOSE_CONTROLLER_REQUIRED=true
MANDOFORGE_FINANCE_CLOSE_CONTROLLER_URL=https://controller.example.com/mandoforge/finance/close
MANDOFORGE_FINANCE_CLOSE_CONTROLLER_TOKEN=
MANDOFORGE_FINANCE_RECONCILIATION_CONTROLLER_REQUIRED=true
MANDOFORGE_FINANCE_RECONCILIATION_CONTROLLER_URL=https://controller.example.com/mandoforge/finance/reconcile
MANDOFORGE_FINANCE_RECONCILIATION_CONTROLLER_TOKEN=
RUN_STAGE2_FINANCE_CONTROLLERS=1
