MANDOFORGE_REMOTE_COMPUTER_STATE_PROVIDER=juicefs
MANDOFORGE_REMOTE_COMPUTER_STATE_CONFLICT_POLICY=one-active-writer-per-session
MANDOFORGE_REMOTE_COMPUTER_STATE_LOCK_MANAGER=true
MANDOFORGE_REMOTE_COMPUTER_RUNNER=kubernetes
MANDOFORGE_REMOTE_COMPUTER_NAMESPACE=agent-os
MANDOFORGE_REMOTE_COMPUTER_KUBECONFIG=/etc/rancher/k3s/k3s.yaml
MANDOFORGE_REMOTE_COMPUTER_MUTATION_ENABLED=true
MANDOFORGE_REMOTE_COMPUTER_LIVE_MUTATION_ENABLED=true
MANDOFORGE_REMOTE_COMPUTER_EXECUTION_TRANSPORT=kubernetes
MANDOFORGE_REMOTE_COMPUTER_EXECUTION_ENABLED=true
MANDOFORGE_REMOTE_COMPUTER_SIDECAR_REPLACEMENT_ENABLED=false
